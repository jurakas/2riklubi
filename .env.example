# Copied to .env by scripts/local-up.ps1 on first run. Local development only.
# Never put production credentials in this file.

# Ports on the host
WP_PORT=8080
MAILPIT_PORT=8025

# Database (MariaDB container)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpassword
DB_PREFIX=wp_

# Used by scripts/setup.sh on first install. SITE_URL must match WP_PORT.
SITE_URL=http://localhost:8080
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-local-only

# Importer switches (1 = on). Leave empty normally.
# AK_FORCE_UPDATE: overwrite imported items even if they were edited in wp-admin.
# AK_RECREATE_DELETED: re-create imported items that were deleted in wp-admin.
AK_FORCE_UPDATE=
AK_RECREATE_DELETED=
